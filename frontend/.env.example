# Frontend Environment Variables
# For Local Unified Server (http://localhost:8000): Leave VITE_API_URL empty
# For Local Vite Dev Server (http://localhost:5173): Leave VITE_API_URL empty (Vite automatically proxies to port 8000)
# For Vercel Frontend + Ngrok Tunnel: Set to your ngrok forwarding URL:
# VITE_API_URL=https://xxxx-xxxx.ngrok-free.app
# For Vercel Frontend + Hosted Backend (Render / Railway): Set to your production backend URL:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=
